modules = ["python-3.11", "bash", "nix"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "zlib", "deno", "ffmpeg"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

